{
  "name": "@agent-network-protocol/dsh-anp",
  "version": "0.1.3",
  "type": "module",
  "description": "ANP discovery and authenticated interaction for DeepSeek Harness",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agent-network-protocol/dsh-anp.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./plugin": "./lib/plugin.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test:system": "node tests/support/run-system.mjs",
    "test:e2e": "node tests/support/run-e2e.mjs",
    "test:acceptance-support": "node --test tests/support/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "playwright": "1.61.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "anp",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@agent-network-protocol/dsh-anp-identity": ">=0.1.14"
  },
  "peerDependenciesMeta": {
    "@agent-network-protocol/dsh-anp-identity": {
      "optional": true
    }
  }
}
